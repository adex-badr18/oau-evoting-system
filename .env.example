# PostgreSQL connection used by the application server only.
DATABASE_URL=postgres://uevs:change-me@localhost:5432/uevs

# 32+ byte random secret; generate separately for each environment.
AUTH_SECRET=replace-with-a-long-random-secret
MFA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# University email relay. Leave blank in local development to log messages instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=University Elections <elections@university.edu>
SUPPORT_EMAIL=oahammed@oauife.edu.ng

# Public application URL, used in invitation links.
APP_URL=http://localhost:3000

# Secret used only by the server scheduler to close expired elections.
MAINTENANCE_SECRET=replace-with-a-separate-long-random-secret

